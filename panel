      </section>

    </main>
  </div>
</div>

<script>
const kpis = [
  { label:"Ingresos por fidelización", value:"S/ 24,850", delta:"+18.2%", up:true, spark:[4,6,5,8,7,9,11,10,13,12,15,16] },
  { label:"Clientes activos", value:"1,204", delta:"+6.4%", up:true, spark:[8,9,8,10,9,11,10,12,11,13,12,14] },
  { label:"Tasa de retorno", value:"68%", delta:"+4.1%", up:true, spark:[5,6,7,6,8,9,8,10,9,11,12,11] },
  { label:"Sellos canjeados", value:"312", delta:"-2.3%", up:false, spark:[12,11,13,10,9,11,9,8,10,7,8,7] },
];

function sparkPath(data, w, h){
  const max = Math.max(...data), min = Math.min(...data);
  const step = w/(data.length-1);
  return data.map((d,i)=>{
    const x = i*step;
    const y = h - ((d-min)/(max-min || 1))*h;
    return (i===0?'M':'L')+x.toFixed(1)+','+y.toFixed(1);
  }).join(' ');
}

function renderKpis(){
  const grid = document.getElementById('kpiGrid');
  grid.innerHTML = kpis.map(k=>{
    const color = k.up ? 'var(--emerald)' : 'var(--red)';
    const pillClass = k.up ? 'pill-emerald' : 'pill-red';
    const arrow = k.up ? '↑' : '↓';
    const path = sparkPath(k.spark, 120, 32);
    return `
    <div class="glass glass-card fade-in" style="border-radius:18px;padding:18px 20px;">
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:10px;">${k.label}</div>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;">
        <div>
          <div class="font-display font-mono" style="font-size:24px;font-weight:700;letter-spacing:-.01em;">${k.value}</div>
          <span class="pill ${pillClass}" style="margin-top:8px;">${arrow} ${k.delta}</span>
        </div>
        <svg width="120" height="32" viewBox="0 0 120 32" style="flex-shrink:0;">
          <path d="${path}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>`;
  }).join('');
}

// revenue area chart
function renderRevenueChart(){
  const data = [12,15,13,18,22,19,25,28,24,30,27,34];
  const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  const w=640,h=220,padL=8,padR=8,padT=10,padB=26;
  const max=Math.max(...data), min=0;
  const innerW=w-padL-padR, innerH=h-padT-padB;
  const step=innerW/(data.length-1);
  const pts=data.map((d,i)=>[padL+i*step, padT+innerH-((d-min)/(max-min))*innerH]);

  function smoothPath(points){
    let d = `M ${points[0][0]},${points[0][1]}`;
    for(let i=0;i<points.length-1;i++){
      const [x0,y0]=points[i], [x1,y1]=points[i+1];
      const mx=(x0+x1)/2;
      d += ` C ${mx},${y0} ${mx},${y1} ${x1},${y1}`;
    }
    return d;
  }
  const linePath = smoothPath(pts);
  const areaPath = linePath + ` L ${pts[pts.length-1][0]},${padT+innerH} L ${pts[0][0]},${padT+innerH} Z`;

  const gridLines = [0,0.33,0.66,1].map(f=>{
    const y = padT + innerH*f;
    return `<line x1="${padL}" y1="${y}" x2="${w-padR}" y2="${y}" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>`;
  }).join('');

  const xLabels = months.map((m,i)=>{
    if(i%2!==0) return '';
    return `<text x="${pts[i][0]}" y="${h-6}" fill="var(--text-tertiary)" font-size="10" text-anchor="middle" font-family="Inter">${m}</text>`;
  }).join('');

  const svg = document.getElementById('revenueChart');
  svg.innerHTML = `
    <defs>
      <linearGradient id="revGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#E7B549" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#E7B549" stop-opacity="0"/>
      </linearGradient>
    </defs>
    ${gridLines}
    <path d="${areaPath}" fill="url(#revGrad)"/>
    <path d="${linePath}" fill="none" stroke="#E7B549" stroke-width="2.5" stroke-linecap="round"/>
    ${pts.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3" fill="#0B0F17" stroke="#E7B549" stroke-width="2"/>`).join('')}
    ${xLabels}
  `;
}

const transactions = [
  {name:"Camila Ruiz", init:"CR", tier:"Oro", tierClass:"pill-gold", date:"Hoy · 14:22", amount:"S/ 68.00", status:"Pagado", statusClass:"pill-emerald"},
  {name:"David Medina", init:"DM", tier:"Plata", tierClass:"pill-slate", date:"Hoy · 12:05", amount:"S/ 24.50", status:"Pendiente", statusClass:"pill-gold"},
  {name:"Rosa Chávez", init:"RC", tier:"Bronce", tierClass:"pill-slate", date:"Ayer · 19:40", amount:"S/ 15.00", status:"Pagado", statusClass:"pill-emerald"},
  {name:"Jorge Salas", init:"JS", tier:"Oro", tierClass:"pill-gold", date:"Ayer · 17:12", amount:"S/ 92.30", status:"Cancelado", statusClass:"pill-red"},
  {name:"Valeria Torres", init:"VT", tier:"Plata", tierClass:"pill-slate", date:"Ayer · 10:58", amount:"S/ 33.00", status:"Pagado", statusClass:"pill-emerald"},
  {name:"Luis Fernández", init:"LF", tier:"Bronce", tierClass:"pill-slate", date:"12 ago · 09:30", amount:"S/ 18.90", status:"Pagado", statusClass:"pill-emerald"},
];

function renderTable(){
  const body = document.getElementById('txBody');
  body.innerHTML = transactions.map(t=>`
    <tr class="row-hover" style="border-top:1px solid var(--border-glass-soft);">
      <td style="padding:12px 22px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <div style="width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;">${t.init}</div>
          <span style="font-weight:500;">${t.name}</span>
        </div>
      </td>
      <td style="padding:12px;"><span class="pill ${t.tierClass}">${t.tier}</span></td>
      <td style="padding:12px;color:var(--text-secondary);" class="font-mono">${t.date}</td>
      <td style="padding:12px;font-weight:600;" class="font-mono">${t.amount}</td>
      <td style="padding:12px;"><span class="pill ${t.statusClass}">${t.status}</span></td>
      <td style="padding:12px 22px;text-align:right;">
        <button style="background:none;border:none;color:var(--text-tertiary);cursor:pointer;padding:4px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
        </button>
      </td>
    </tr>
  `).join('');
}

// initial skeleton state, then reveal
function showSkeletons(){
  const grid = document.getElementById('kpiGrid');
  grid.innerHTML = Array(4).fill(0).map(()=>`
    <div class="glass" style="border-radius:18px;padding:18px 20px;">
      <div class="skeleton" style="width:60%;height:11px;margin-bottom:14px;"></div>
      <div class="skeleton" style="width:80%;height:24px;margin-bottom:10px;"></div>
      <div class="skeleton" style="width:40%;height:16px;"></div>
    </div>
  `).join('');
}

showSkeletons();
setTimeout(()=>{
  renderKpis();
  renderRevenueChart();
  renderTable();
}, 650);

// cmd+k focus
document.addEventListener('keydown',(e)=>{
  if((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){
    e.preventDefault();
    document.querySelector('input[type=text]').focus();
  }
});
</script>
</body>
</html>
