<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ExpandeMoney — Panel de Fidelización</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-base:#0B0F17;
    --bg-base-2:#0D1220;
    --glass:rgba(255,255,255,0.055);
    --glass-hover:rgba(255,255,255,0.09);
    --glass-strong:rgba(255,255,255,0.09);
    --border-glass:rgba(255,255,255,0.10);
    --border-glass-soft:rgba(255,255,255,0.06);
    --gold:#E7B549;
    --gold-soft:#F4CB6B;
    --gold-dim:rgba(231,181,73,0.16);
    --emerald:#34D399;
    --emerald-dim:rgba(52,211,153,0.14);
    --red:#F87171;
    --red-dim:rgba(248,113,113,0.14);
    --text-primary:#EAEDF3;
    --text-secondary:#8A93A6;
    --text-tertiary:#5B6478;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg-base);
    color:var(--text-primary);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    overflow-x:hidden;
    position:relative;
  }
  .font-display{font-family:'Plus Jakarta Sans',sans-serif;}
  .font-mono{font-family:'JetBrains Mono',monospace;}

  /* ambient glow orbs */
  .orb{position:fixed;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0;}
  .orb-1{width:520px;height:520px;background:rgba(231,181,73,0.10);top:-180px;left:-120px;}
  .orb-2{width:460px;height:460px;background:rgba(59,130,246,0.10);top:-100px;right:-160px;}
  .orb-3{width:600px;height:600px;background:rgba(139,92,246,0.08);bottom:-260px;left:38%;}
  .orb-4{width:380px;height:380px;background:rgba(52,211,153,0.07);bottom:-120px;right:10%;}

  .glass{
    background:var(--glass);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border:1px solid var(--border-glass);
    box-shadow:0 8px 32px rgba(0,0,0,0.35);
  }
  .glass-strong{
    background:var(--glass-strong);
    backdrop-filter:blur(28px);
    -webkit-backdrop-filter:blur(28px);
    border:1px solid var(--border-glass);
  }
  .glass-card{
    transition:background .25s ease, border-color .25s ease, transform .25s ease;
  }
  .glass-card:hover{
    background:var(--glass-hover);
    border-color:rgba(255,255,255,0.16);
  }

  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.12);border-radius:8px;}
  ::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,0.2);}

  .nav-item{
    display:flex;align-items:center;gap:12px;
    padding:10px 12px;border-radius:12px;
    color:var(--text-secondary);
    font-size:13.5px;font-weight:500;
    cursor:pointer;transition:all .2s ease;
    border:1px solid transparent;
    position:relative;
  }
  .nav-item:hover{background:rgba(255,255,255,0.05);color:var(--text-primary);}
  .nav-item.active{
    background:linear-gradient(135deg, rgba(231,181,73,0.14), rgba(231,181,73,0.04));
    color:var(--gold-soft);
    border-color:rgba(231,181,73,0.25);
  }
  .nav-item.active::before{
    content:'';position:absolute;left:-13px;top:50%;transform:translateY(-50%);
    width:3px;height:16px;border-radius:3px;background:var(--gold);
    box-shadow:0 0 12px var(--gold);
  }

  .pill{
    display:inline-flex;align-items:center;gap:6px;
    padding:3px 10px;border-radius:999px;
    font-size:11px;font-weight:600;letter-spacing:.02em;
  }
  .pill-gold{background:var(--gold-dim);color:var(--gold-soft);border:1px solid rgba(231,181,73,0.3);}
  .pill-emerald{background:var(--emerald-dim);color:var(--emerald);border:1px solid rgba(52,211,153,0.3);}
  .pill-red{background:var(--red-dim);color:var(--red);border:1px solid rgba(248,113,113,0.3);}
  .pill-slate{background:rgba(255,255,255,0.06);color:var(--text-secondary);border:1px solid rgba(255,255,255,0.1);}

  .skeleton{
    background:linear-gradient(100deg, rgba(255,255,255,0.04) 30%, rgba(255,255,255,0.09) 50%, rgba(255,255,255,0.04) 70%);
    background-size:200% 100%;
    animation:shimmer 1.6s infinite;
    border-radius:8px;
  }
  @keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}

  .fade-in{animation:fadeIn .5s ease forwards;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  .stamp-card{
    background:linear-gradient(160deg, rgba(231,181,73,0.14), rgba(255,255,255,0.03) 60%);
    border:1px solid rgba(231,181,73,0.28);
    position:relative;
    overflow:hidden;
  }
  .stamp-card::after{
    content:'';position:absolute;top:0;bottom:0;left:64%;
    width:1px;
    background-image:linear-gradient(rgba(255,255,255,0.25) 50%, transparent 0%);
    background-size:1px 10px;background-repeat:repeat-y;
  }
  .stamp-notch{
    position:absolute;width:22px;height:22px;border-radius:50%;
    background:var(--bg-base);
    left:calc(64% - 11px);
  }

  .row-hover{transition:background .18s ease;}
  .row-hover:hover{background:rgba(255,255,255,0.045);}

  input[type=text]:focus, button:focus-visible{outline:2px solid rgba(231,181,73,0.5);outline-offset:2px;}

  @media (max-width:900px){
    .sidebar{display:none;}
  }
</style>
</head>
<body>

<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>
<div class="orb orb-4"></div>

<div style="position:relative;z-index:1;display:flex;min-height:100vh;">

  <!-- SIDEBAR -->
  <aside class="sidebar glass-strong" style="width:248px;flex-shrink:0;display:flex;flex-direction:column;padding:20px 14px;position:sticky;top:0;height:100vh;border-right:1px solid var(--border-glass);">
    <div style="display:flex;align-items:center;gap:10px;padding:6px 8px 20px 8px;">
      <div style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--gold),#B9852E);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(231,181,73,0.35);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B0F17" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <div>
        <div class="font-display" style="font-weight:800;font-size:15px;letter-spacing:-.01em;">expande<span style="color:var(--gold-soft);">money</span></div>
        <div style="font-size:10.5px;color:var(--text-tertiary);">by ExpandeLab</div>
      </div>
    </div>

    <!-- workspace switcher -->
    <button class="glass-card" style="display:flex;align-items:center;gap:10px;width:100%;padding:9px 10px;border-radius:12px;border:1px solid var(--border-glass-soft);background:rgba(255,255,255,0.03);color:var(--text-primary);cursor:pointer;margin-bottom:18px;">
      <div style="width:26px;height:26px;border-radius:8px;background:var(--gold-dim);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--gold-soft);">GB</div>
      <div style="text-align:left;flex:1;">
        <div style="font-size:12.5px;font-weight:600;">Gold Bird — Lima</div>
        <div style="font-size:10.5px;color:var(--text-tertiary);">Espacio de comercio</div>
      </div>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-tertiary);"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
    </button>

    <div style="font-size:10.5px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.08em;padding:0 10px 6px;">General</div>
    <nav style="display:flex;flex-direction:column;gap:2px;margin-bottom:16px;">
      <div class="nav-item active">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Resumen
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Clientes
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/></svg>
        Comercios
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6M2 7h20v5H2zM12 22V7M12 7a2.5 2.5 0 1 1-2.5-2.5C11 4.5 12 7 12 7ZM12 7a2.5 2.5 0 1 0 2.5-2.5C13 4.5 12 7 12 7Z"/></svg>
        Recompensas
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Transacciones
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 15l4-6 4 4 5-7"/></svg>
        Reportes
      </div>
    </nav>

    <div style="margin-top:auto;display:flex;flex-direction:column;gap:2px;padding-top:10px;border-top:1px solid var(--border-glass-soft);">
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.5 9a2.5 2.5 0 0 1 4.9.8c0 1.7-2.4 2-2.4 3.4M12 17.5v.1"/></svg>
        Soporte
      </div>
      <div class="nav-item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z"/></svg>
        Configuración
      </div>
      <button id="themeToggle" class="nav-item" style="border:none;background:none;cursor:pointer;justify-content:space-between;width:100%;">
        <span style="display:flex;align-items:center;gap:12px;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          Tema
        </span>
        <span class="pill pill-slate" style="font-size:10px;">Oscuro</span>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <div style="flex:1;min-width:0;display:flex;flex-direction:column;">

    <!-- HEADER -->
    <header style="position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:16px;padding:14px 28px;backdrop-filter:blur(18px);background:rgba(11,15,23,0.55);border-bottom:1px solid var(--border-glass-soft);">
      <div class="glass-card" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:12px;border:1px solid var(--border-glass);flex:1;max-width:380px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-tertiary);flex-shrink:0;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" placeholder="Buscar clientes, comercios, transacciones..." style="background:none;border:none;color:var(--text-primary);font-size:13px;width:100%;">
        <span class="pill pill-slate font-mono" style="font-size:10px;padding:2px 6px;">⌘K</span>
      </div>

      <div style="flex:1;"></div>

      <button class="glass-card" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:12px;border:1px solid var(--border-glass);background:rgba(255,255,255,0.03);color:var(--text-secondary);font-size:12.5px;cursor:pointer;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Últimos 30 días
      </button>
      <button class="glass-card" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:12px;border:1px solid var(--border-glass);background:rgba(255,255,255,0.03);color:var(--text-secondary);font-size:12.5px;cursor:pointer;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        Todo el equipo
      </button>

      <button class="glass-card" style="position:relative;width:36px;height:36px;border-radius:11px;border:1px solid var(--border-glass);background:rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-secondary);"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        <span style="position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 6px var(--red);"></span>
      </button>

      <div style="display:flex;align-items:center;gap:9px;padding-left:6px;">
        <div style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#F4CB6B,#B9852E);display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#0B0F17;">MR</div>
        <div style="line-height:1.15;">
          <div style="font-size:12.5px;font-weight:600;">María Rojas</div>
          <div style="font-size:10.5px;color:var(--text-tertiary);">Administradora</div>
        </div>
      </div>
    </header>

    <!-- CONTENT -->
    <main style="padding:24px 28px 60px;display:flex;flex-direction:column;gap:22px;">

      <div>
        <h1 class="font-display" style="font-size:21px;font-weight:700;letter-spacing:-.01em;margin:0 0 3px;">Hola, María — así va Gold Bird hoy</h1>
        <p style="font-size:13px;color:var(--text-secondary);margin:0;">Cada sello, convertido en un número. Esto es lo que tu fidelización generó este mes.</p>
      </div>

      <!-- KPI GRID -->
      <section id="kpiGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
        <!-- filled by JS (skeleton -> real) -->
      </section>

      <!-- CHARTS ROW -->
      <section style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:stretch;">

        <!-- revenue chart -->
        <div class="glass glass-card" style="border-radius:20px;padding:22px 22px 10px;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;">
            <div>
              <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Ingresos por fidelización</div>
              <div style="font-size:11.5px;color:var(--text-tertiary);">Monto recuperado por clientes que vuelven</div>
            </div>
            <div style="display:flex;gap:8px;">
              <span class="pill pill-gold">● Este año</span>
              <span class="pill pill-slate">● Año anterior</span>
            </div>
          </div>
          <svg id="revenueChart" viewBox="0 0 640 220" style="width:100%;height:220px;overflow:visible;"></svg>
        </div>

        <!-- loyalty pipeline (stamp tiers) -->
        <div class="glass glass-card" style="border-radius:20px;padding:22px;display:flex;flex-direction:column;gap:16px;">
          <div>
            <div style="font-size:13px;font-weight:600;">Pipeline de fidelización</div>
            <div style="font-size:11.5px;color:var(--text-tertiary);">Clientes por nivel de tarjeta</div>
          </div>

          <div style="display:flex;flex-direction:column;gap:14px;">
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                <span style="color:var(--text-secondary);">🥉 Bronce</span>
                <span class="font-mono" style="color:var(--text-primary);">612</span>
              </div>
              <div style="height:8px;border-radius:6px;background:rgba(255,255,255,0.06);overflow:hidden;">
                <div style="height:100%;width:82%;border-radius:6px;background:linear-gradient(90deg,#8a6a3a,#c99a55);"></div>
              </div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                <span style="color:var(--text-secondary);">🥈 Plata</span>
                <span class="font-mono" style="color:var(--text-primary);">381</span>
              </div>
              <div style="height:8px;border-radius:6px;background:rgba(255,255,255,0.06);overflow:hidden;">
                <div style="height:100%;width:51%;border-radius:6px;background:linear-gradient(90deg,#9aa3b0,#e4e9f0);"></div>
              </div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                <span style="color:var(--gold-soft);">🥇 Oro</span>
                <span class="font-mono" style="color:var(--gold-soft);">211</span>
              </div>
              <div style="height:8px;border-radius:6px;background:rgba(255,255,255,0.06);overflow:hidden;">
                <div style="height:100%;width:28%;border-radius:6px;background:linear-gradient(90deg,var(--gold),var(--gold-soft));box-shadow:0 0 10px rgba(231,181,73,0.5);"></div>
              </div>
            </div>
          </div>

          <div style="margin-top:auto;padding-top:12px;border-top:1px solid var(--border-glass-soft);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:11.5px;color:var(--text-tertiary);">Tasa de ascenso mensual</span>
            <span class="pill pill-emerald">↑ 12.4%</span>
          </div>
        </div>
      </section>

      <!-- SIGNATURE: stamp / boarding-pass widget + secondary stat -->
      <section style="display:grid;grid-template-columns:1.3fr 1fr;gap:16px;">
        <div class="stamp-card" style="border-radius:20px;padding:0;display:flex;min-height:150px;">
          <div class="stamp-notch" style="top:-11px;"></div>
          <div class="stamp-notch" style="bottom:-11px;"></div>
          <div style="flex:1;padding:20px 24px;display:flex;flex-direction:column;justify-content:center;gap:10px;">
            <span class="pill pill-gold" style="width:fit-content;">Cliente destacado del día</span>
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--gold-soft),#B9852E);display:flex;align-items:center;justify-content:center;font-weight:700;color:#0B0F17;">CR</div>
              <div>
                <div class="font-display" style="font-size:16px;font-weight:700;">Camila Ruiz</div>
                <div style="font-size:11.5px;color:var(--text-tertiary);">Nivel Oro · 9na visita este mes</div>
              </div>
            </div>
            <div style="font-size:11.5px;color:var(--text-secondary);">Le falta <span style="color:var(--gold-soft);font-weight:600;">1 sello</span> para canjear su próxima recompensa.</div>
          </div>
          <div style="width:38%;padding:20px 24px;display:flex;flex-direction:column;justify-content:center;gap:8px;">
            <div style="font-size:10.5px;color:var(--text-tertiary);letter-spacing:.04em;">TARJETA DIGITAL</div>
            <div style="display:flex;gap:6px;">
              <span style="width:22px;height:22px;border-radius:50%;background:var(--gold);"></span>
              <span style="width:22px;height:22px;border-radius:50%;background:var(--gold);"></span>
              <span style="width:22px;height:22px;border-radius:50%;background:var(--gold);"></span>
              <span style="width:22px;height:22px;border-radius:50%;background:var(--gold);"></span>
              <span style="width:22px;height:22px;border-radius:50%;border:1.5px dashed rgba(231,181,73,0.5);"></span>
            </div>
            <div class="font-mono" style="font-size:11px;color:var(--gold-soft);">4/5 sellos</div>
          </div>
        </div>

        <div class="glass glass-card" style="border-radius:20px;padding:22px;display:flex;flex-direction:column;justify-content:space-between;">
          <div>
            <div style="font-size:13px;font-weight:600;margin-bottom:4px;">Valor promedio recuperado</div>
            <div style="font-size:11.5px;color:var(--text-tertiary);margin-bottom:14px;">Por cliente que regresa vs. cliente nuevo</div>
          </div>
          <div style="display:flex;align-items:flex-end;gap:22px;">
            <div>
              <div class="font-display font-mono" style="font-size:26px;font-weight:700;color:var(--gold-soft);">S/ 84.20</div>
              <div style="font-size:11px;color:var(--text-tertiary);">Cliente recurrente</div>
            </div>
            <div>
              <div class="font-display font-mono" style="font-size:26px;font-weight:700;color:var(--text-secondary);">S/ 41.50</div>
              <div style="font-size:11px;color:var(--text-tertiary);">Cliente nuevo</div>
            </div>
          </div>
        </div>
      </section>

      <!-- TABLE -->
      <section class="glass glass-card" style="border-radius:20px;overflow:hidden;">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 22px;border-bottom:1px solid var(--border-glass-soft);">
          <div>
            <div style="font-size:13px;font-weight:600;">Últimas transacciones</div>
            <div style="font-size:11.5px;color:var(--text-tertiary);">Sellos y canjes en tiempo real</div>
          </div>
          <button class="pill pill-slate" style="cursor:pointer;">Ver todas →</button>
        </div>
        <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
          <thead>
            <tr style="text-align:left;color:var(--text-tertiary);font-size:11px;text-transform:uppercase;letter-spacing:.04em;">
              <th style="padding:10px 22px;font-weight:500;">Cliente</th>
              <th style="padding:10px 12px;font-weight:500;">Nivel</th>
              <th style="padding:10px 12px;font-weight:500;">Última visita</th>
              <th style="padding:10px 12px;font-weight:500;">Monto</th>
              <th style="padding:10px 12px;font-weight:500;">Estado</th>
              <th style="padding:10px 22px;font-weight:500;"></th>
            </tr>
          </thead>
          <tbody id="txBody"></tbody>
        </table>
